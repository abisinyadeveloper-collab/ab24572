{
  "version": 1,
  "sdk_version": "3.3.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gtukwysuakrwsptslfpn.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "screenshot-exact-match",
      "version": "0.1.0",
      "title": "Screenshot Exact Match"
    },
    "tools": [
      {
        "name": "list_chats",
        "title": "List chats",
        "description": "List your most recent Ghost conversations with their IDs and titles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many chats to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_chat",
        "title": "Read chat",
        "description": "Read the text messages of one of your Ghost conversations by ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Chat ID from list_chats."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_memories",
        "title": "List memories",
        "description": "List the facts Ghost remembers about you.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_memory",
        "title": "Add memory",
        "description": "Save a fact about you that Ghost should remember across chats.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "The fact to remember."
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
